# Copy this file to .env and fill in the keys you need.
#   cp .env.example .env
# Never share or commit this file - it holds credentials.

# --- Model provider (pick the one you use) ---
# Default: openrouter (https://openrouter.ai/). One key unlocks a huge
# catalogue including free-tier models that rotate monthly.
# OPENROUTER_API_KEY=

# --- Alternative router (optional) ---
# ORCAROUTER_API_KEY=

# --- Fallback provider (optional) ---
# DEEPSEEK_API_KEY=

# --- Delivery channel (Telegram recommended) ---
# Create a bot with @BotFather (https://t.me/BotFather), then paste the token.
# TELEGRAM_BOT_TOKEN=

# --- Web search (optional; free tier) ---
# JINA_API_KEY=

# --- Local models (LM Studio / Ollama) do not need a key here ---
# Point the profile at http://localhost:1234/v1 (LM Studio) or
# http://localhost:11434/v1 (Ollama). See INSTALL.md Step 5.
